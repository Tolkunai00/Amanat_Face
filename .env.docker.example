# Copy this file to .env.docker. Never commit the real file.
POSTGRES_DB=amanat
POSTGRES_USER=amanat
POSTGRES_PASSWORD=change_this_database_password_123456

ADMIN_PASSWORD=change_this_admin_password_123456

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RTSP secrets belong only in the untracked .env.docker file.
# Format: rtsp://camera_user:URL_ENCODED_PASSWORD@192.168.1.100:554/stream/path
# Use the exact stream path documented by the camera vendor (often /Streaming/Channels/101).
CAMERA_KELDI_SOURCE=
CAMERA_KETTI_SOURCE=
# Numeric values (0, 1) select USB cameras, but a host USB webcam is not
# automatically available inside Docker Desktop on Windows.

RECOGNITION_WIDTH=480
RECOGNITION_INTERVAL_SECONDS=0.8
FACE_MODEL_NAME=buffalo_l
# Keep non-commercial until a production model license has actually been obtained.
FACE_MODEL_LICENSE=non-commercial
# Path to a separately selected and licensed presentation-attack detector.
ANTI_SPOOFING_MODEL_PATH=
FSVFM_ENABLED=true
FSVFM_SHADOW_MODE=true
FSVFM_CHECKPOINT=
FSVFM_THRESHOLD=0.50

WARM_UP_RECOGNITION=0

LIVENESS_REQUIRED_SAMPLES=3
LIVENESS_WINDOW_SECONDS=8.0
