# Copy this file to .env.docker.
# Never commit the real .env.docker file.

POSTGRES_DB=amanat
POSTGRES_USER=amanat
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD_32

ADMIN_PASSWORD=CHANGE_ME_DIFFERENT_ADMIN_PASSWORD_32

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# =========================
# Cameras
# =========================

# Network / RTSP camera for entrance.
CAMERA_KELDI_SOURCE=

# Local webcam index.
# Important:
# Docker Desktop on Windows does not automatically expose Windows webcams
# to a Linux container.
CAMERA_KETTI_SOURCE=0


# =========================
# Recognition
# =========================

RECOGNITION_WIDTH=480
RECOGNITION_INTERVAL_SECONDS=0.8
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_LICENSE=non-commercial
ANTI_SPOOFING_MODEL_PATH=
ANTI_SPOOFING_MODEL_TYPE=minifasnet_v2_80
ANTI_SPOOFING_MODEL_SHA256=
ANTI_SPOOFING_CLASS_NAMES=print,live,replay
ANTI_SPOOFING_CACHE_TTL_SECONDS=2.0
FSVFM_ENABLED=true
FSVFM_SHADOW_MODE=true
FSVFM_CHECKPOINT=
FSVFM_THRESHOLD=0.50
FACE_DETECTION_FALLBACK_ENABLED=true
FACE_DETECTION_MIN_CONFIDENCE=0.50
FACE_TRACK_MAX_MISSED_FRAMES=8
FACE_TRACK_TTL_SECONDS=3.0
WARM_UP_RECOGNITION=0


# =========================
# Liveness
# =========================

LIVENESS_REQUIRED_SAMPLES=3
LIVENESS_WINDOW_SECONDS=8.0
