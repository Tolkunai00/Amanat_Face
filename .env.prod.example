# Amanat Face production environment template.
# Copy to .env.prod; never put real passwords or camera credentials in Git.

# REQUIRED: runtime mode. PRODUCTION=1 remains a Compose compatibility input.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
AUTO_MIGRATE=false
RELEASE_VERSION=replace-with-git-tag-or-commit

# REQUIRED: public name and the existing business timezone.
DOMAIN=school.example.com
TZ=Asia/Bishkek
CORS_ALLOWED_ORIGINS=https://school.example.com

# REQUIRED: identifiers. Password and DATABASE_URL are Docker secrets in
# deploy/secrets/postgres_password. The backend constructs DATABASE_URL from
# these non-secret identifiers plus that one password source.
POSTGRES_DB=amanat
POSTGRES_USER=amanat

# REQUIRED: the opaque server-session administrator password is supplied via
# deploy/secrets/admin_bootstrap_password. Session token HMAC key is supplied
# only through deploy/secrets/session_secret. This application does not use JWT.

# REQUIRED: complete RTSP URLs with URL-encoded credentials. Keep real values untracked.
CAMERA_KELDI_SOURCE=rtsp://user:password@camera-entrance/stream
CAMERA_KETTI_SOURCE=rtsp://user:password@camera-exit/stream

# REQUIRED: identity model must have written production authorization.
FACE_MODEL_NAME=licensed_model_package
RECOGNITION_THRESHOLD=0.52
RECOGNITION_MARGIN=0.06

# REQUIRED: production MiniFAS artifact and reviewed digest.
ANTI_SPOOFING_THRESHOLD=0.80
ANTI_SPOOFING_MODEL_PATH=/models/anti_spoof.onnx
ANTI_SPOOFING_MODEL_TYPE=minifasnet_v2_80
ANTI_SPOOFING_MODEL_SHA256=D7B3CD9BA8A7CEB13BAA8C4720902E27CA3112EFF52F926C08804AF6B6EECC7B
ANTI_SPOOFING_CLASS_NAMES=print,live,replay
ANTI_SPOOFING_CACHE_TTL_SECONDS=2.0
ANTI_SPOOFING_LIVE_INDEX=1
ANTI_SPOOFING_OUTPUT=logits

# REQUIRED while enabled. FS-VFM remains diagnostic shadow-only.
FSVFM_ENABLED=true
FSVFM_SHADOW_MODE=true
FSVFM_CHECKPOINT=/models/fsvfm_vit_s_oci2m_run0.pth.tar
FSVFM_CHECKPOINT_SHA256=C594C083CB265C3BB39ACCDA0E3F492E0B23D3C0CF7FC45FAC2C94E8A5750B9D
FSVFM_THRESHOLD=0.50

# OPTIONAL tuning. Defaults are explicit for reproducibility.
RECOGNITION_WIDTH=480
RECOGNITION_INTERVAL_SECONDS=0.8
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# OPTIONAL off-host interface. "none" is explicit and reported as not configured.
# For filesystem mode, set OFFSITE_BACKUP_DIR_HOST to a mounted second disk.
OFFSITE_BACKUP_MODE=none
OFFSITE_BACKUP_DIR_HOST=./data/offsite_backups
OFFSITE_S3_URI=

# OPTIONAL alert delivery. Empty is honest: Alertmanager runs with a safe sink
# and readiness reports alert_delivery=not_configured. Point the config path at
# an untracked receiver config and set a non-secret receiver label when enabled.
ALERTMANAGER_CONFIG_FILE=./deploy/alertmanager/alertmanager.yml
ALERTMANAGER_RECEIVER=

# Initial disk/log guardrails; alert thresholds require operational tuning.
DISK_WARNING_PERCENT=10
DISK_CRITICAL_PERCENT=5
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# OPTIONAL camera reliability diagnostics.
CAMERA_READ_MAX_SECONDS=7
CAMERA_OFFLINE_TIMEOUT_SECONDS=30
CAMERA_STALE_ENABLED=true
CAMERA_STALE_TIMEOUT_SECONDS=10
CAMERA_STALE_CONSECUTIVE_FRAMES=30

# DEV-ONLY: SQLite test mode and localhost CORS origins must not be added here.
