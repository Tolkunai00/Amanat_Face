PRODUCTION=1
APP_HOST=0.0.0.0
APP_PORT=8080
APP_AUTO_PORT=0

# Required in production. Generate a unique secret (at least 12 characters).
ADMIN_PASSWORD=

# Exact comma-separated frontend origins.
ALLOWED_ORIGINS=https://app.example.com

# Required. SQLite is not supported as a runtime database.
DATABASE_URL=postgresql+psycopg://amanat:CHANGE_ME@127.0.0.1:5432/amanat
FACE_DIR=face_database
SCREENSHOTS_DIR=screenshots
SCREENSHOT_RETENTION_DAYS=7
SCREENSHOT_CLEANUP_INTERVAL_MINUTES=60
MAX_UPLOAD_BYTES=5242880
ATTENDANCE_DEBOUNCE_SECONDS=60
ATTENDANCE_TIMEZONE=Asia/Bishkek

CAMERA_FPS=40
# Local USB camera: 0 or 1. IP camera: a complete private RTSP URL.
# Example only (never commit real credentials):
# rtsp://camera_user:URL_ENCODED_PASSWORD@192.168.1.100:554/stream/path
CAMERA_KELDI_SOURCE=0
CAMERA_KETTI_SOURCE=1
RECOGNITION_WIDTH=640
RECOGNITION_INTERVAL_SECONDS=0.18
WARM_UP_RECOGNITION=0
LIVENESS_REQUIRED_SAMPLES=4
LIVENESS_WINDOW_SECONDS=3.0
LIVENESS_MIN_POSE_CHANGE=0.018
LIVENESS_MAX_FACE_MOTION=0.22
